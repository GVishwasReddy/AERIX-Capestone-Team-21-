# Copy to .env and fill in. Never commit the real .env or the service account key.

# --- Home / geofence -------------------------------------------------------
# Set these to your actual launch point before any real flight.
HOME_LAT=-35.363262
HOME_LON=149.165237
GEOFENCE_RADIUS_M=300
MIN_ALTITUDE_M=2
MAX_ALTITUDE_M=50
HOVER_ALTITUDE_M=5
ARRIVAL_TOLERANCE_M=2

# --- Failsafes -------------------------------------------------------------
HOVER_TIMEOUT_S=120
BATTERY_FAILSAFE_PCT=20

# --- MAVLink ---------------------------------------------------------------
# SITL:          udp://:14540
# Real Pixhawk:  serial:///dev/ttyACM0:115200
MAVLINK_CONNECTION=udp://:14540

# Endpoint the lidar bridge sends OBSTACLE_DISTANCE on. Defaults to
# MAVLINK_CONNECTION, which is only correct when that is a UDP endpoint.
#
# On real hardware they MUST differ: MAVSDK and pymavlink cannot both hold
# /dev/ttyACM0 — they would steal each other's bytes. Run mavlink-router (or
# mavproxy) to fan the serial link out to two UDP endpoints, then point
# MAVLINK_CONNECTION at one and LIDAR_MAVLINK_CONNECTION at the other:
#   MAVLINK_CONNECTION=udp://:14540
#   LIDAR_MAVLINK_CONNECTION=udp://127.0.0.1:14550
# LIDAR_MAVLINK_CONNECTION=

# --- Lidar (RPLIDAR C1) ----------------------------------------------------
# Use the stable by-id path, NOT /dev/ttyUSB0. The CP2102N re-enumerates
# (ttyUSB0 -> ttyUSB1 -> ttyUSB2) after any USB reset, and a hardcoded ttyUSB0
# then fails with "No such file or directory". Find yours with:
#   ls -l /dev/serial/by-id/
LIDAR_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_3e8e15cb1664ef11b066daa9c169b110-if00-port0
LIDAR_BAUD=460800

# --- Firebase --------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=./service-account.json
FIREBASE_DB_URL=https://aerix-test-v1-default-rtdb.firebaseio.com

# --- Logging ---------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
